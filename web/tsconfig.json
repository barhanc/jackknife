{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["tsover", "ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "vite/client", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": false
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
